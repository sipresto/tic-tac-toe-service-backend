@baseUrl = http://localhost:8096

### Create game

POST {{baseUrl}}/api/tictactoe
Content-Type: application/json
Accept: application/json

{
  "players": [
    "8e5823e3-1b6d-4c90-96ef-2fbdb0e43bc0"
  ],
  "difficulty": "HARD"
}

> {%
    const url = response.body.gameUrl;
    const gameId = url.split('/').pop();
    client.global.set("gameId", gameId);
%}

### Make a move

POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "8e5823e3-1b6d-4c90-96ef-2fbdb0e43bc0",
  "row": 1,
  "col": 1
}

### AI make a move

POST {{baseUrl}}/api/tictactoe/{{gameId}}/ai-move
Accept: application/json

### Rematch

POST {{baseUrl}}/api/tictactoe/{{gameId}}/rematch
Accept: application/json

> {%
    client.global.set("gameId", response.body['id']);
%}

### Make a move

GET {{baseUrl}}/api/tictactoe/{{gameId}}
Content-Type: application/json
Accept: application/json