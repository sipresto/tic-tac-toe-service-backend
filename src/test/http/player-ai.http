@baseUrl = http://localhost/api/games/tictactoe
POST http://localhost/auth/realms/game_platform/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=game-platform&client_secret=R4HlYySrlWmAKObuHf1N0HAtSm3hiThC&username=Johnny&password=Test123&grant_type=password&scope=openid

> {%
    client.global.set("token", response.body.access_token);
%}

### Create game

POST {{baseUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "players": [
    "8e5823e3-1b6d-4c90-96ef-2fbdb0e43bc0"
  ],
  "difficulty": "HARD"
}

> {%
    const url = response.body.gameUrl;
    const gameId = url.split('/').pop();
    client.global.set("gameId", gameId);
%}

### Make a move

POST {{baseUrl}}/{{gameId}}/move
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "playerId": "8e5823e3-1b6d-4c90-96ef-2fbdb0e43bc0",
  "row": 1,
  "col": 1
}

### AI make a move

POST {{baseUrl}}/{{gameId}}/ai-move
Accept: application/json
Authorization: Bearer {{token}}


### Resign
POST {{baseUrl}}/{{gameId}}/resign
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "playerId": "8e5823e3-1b6d-4c90-96ef-2fbdb0e43bc0"
}

