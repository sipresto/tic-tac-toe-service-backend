@baseUrl = http://localhost:8096

### Create game

POST {{baseUrl}}/api/tictactoe
Content-Type: application/json
Accept: application/json

{
  "players": [
    "8e6dd3e3-1b6d-4c90-96ef-2fbdb0e43bc0",
    "f2c9c2b8-e7c9-4f47-9c2b-7c3e2ccf48ad"
  ],
  "difficulty": "HARD"
}

> {%
    const url = response.body.gameUrl;
    const gameId = url.split('/').pop();
    client.global.set("gameId", gameId);
%}

### Player 1 move 1

POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "8e6dd3e3-1b6d-4c90-96ef-2fbdb0e43bc0",
  "row": 1,
  "col": 1
}

### Player 2 wrong move

POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "f2c9c2b8-e7c9-4f47-9c2b-7c3e2ccf48ad",
  "row": 1,
  "col": 1
}

### Player 2 move 1
POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "f2c9c2b8-e7c9-4f47-9c2b-7c3e2ccf48ad",
  "row": 1,
  "col": 0
}

### Player 1 move 2

POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "8e6dd3e3-1b6d-4c90-96ef-2fbdb0e43bc0",
  "row": 0,
  "col": 0
}

### Player 2 move 2
POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "f2c9c2b8-e7c9-4f47-9c2b-7c3e2ccf48ad",
  "row": 2,
  "col": 0
}

### Player 1 move 3

POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "8e6dd3e3-1b6d-4c90-96ef-2fbdb0e43bc0",
  "row": 2,
  "col": 2
}

### Player 2 game is over
POST {{baseUrl}}/api/tictactoe/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "f2c9c2b8-e7c9-4f47-9c2b-7c3e2ccf48ad",
  "row": 1,
  "col": 2
}

### Rematch

POST {{baseUrl}}/api/tictactoe/{{gameId}}/rematch
Accept: application/json

> {%
    client.global.set("gameId", response.body['id']);
%}