@baseUrl = http://localhost/api/games/tictactoe
@playerId1 = cf0138b7-3272-4d1c-a34d-de88a47fe94c
@playerId2 = 6d0cdf67-26c4-4354-a4df-9c4a7575dbb6

POST http://localhost/auth/realms/game_platform/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=game-platform&client_secret=Ik0Ek2wANj5NXLUh6ZWd7SBD8XbxkFVv&username=johnny&password=Test123&grant_type=password&scope=openid

> {%
    client.global.set("token", response.body.access_token);
%}

### Create game

POST {{baseUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "players": [
    "{{playerId1}}",
    "{{playerId2}}"
  ],
  "difficulty": null
}

> {%
    const url = response.body.gameUrl;
    const gameId = url.split('/').pop();
    client.global.set("gameId", gameId);
%}

### Player 1 move 1

POST {{baseUrl}}/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "{{playerId1}}",
  "row": 1,
  "col": 1
}

### Player 2 wrong move

POST {{baseUrl}}/{{gameId}}/move
Content-Type: application/json
Accept: application/json

{
  "playerId": "{{playerId2}}",
  "row": 1,
  "col": 1
}

### Player 2 move 1
POST {{baseUrl}}/{{gameId}}/move
Content-Type: application/json
